# Maintainer: Ian Ahuja <hello@miniti.app>
# Prebuilt miniti Linux from the GitHub Release tarball (built on Ubuntu 22.04 / glibc 2.35).
pkgname=miniti-bin
pkgver=0.4.0
pkgrel=1
pkgdesc="miniti — AI meeting assistant with live transcription, insights and coaching (prebuilt)"
arch=('x86_64')
url="https://github.com/12ian34/miniti-linux"
license=('Elastic-2.0')
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'librsvg' 'libappindicator-gtk3' 'openssl'
         'pipewire' 'pipewire-pulse' 'libpulse' 'libsecret' 'libnotify' 'hicolor-icon-theme')
optdepends=('gtk-layer-shell: pin the floating recording surface on Wayland compositors (Hyprland, Sway, KDE)'
            'gnome-keyring: keep the account credentials and device id in the secret service'
            'xdg-utils: open Polar / OAuth pages in the browser')
provides=('miniti')
conflicts=('miniti' 'miniti-git')
source=("https://github.com/12ian34/miniti-linux/releases/download/v${pkgver}/miniti-${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
sha256sums=('0b63c03019d624a2cc97aea0b9f92d3bb608e00ca02b629835513892aa4b390b')

package() {
  cd "miniti-${pkgver}-x86_64-unknown-linux-gnu"
  install -Dm755 miniti "${pkgdir}/usr/bin/miniti"
  install -Dm644 miniti.desktop "${pkgdir}/usr/share/applications/miniti.desktop"
  for size in 32x32 128x128 256x256@2; do
    install -Dm644 "icons/hicolor/${size}/apps/miniti.png" "${pkgdir}/usr/share/icons/hicolor/${size}/apps/miniti.png"
  done
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
