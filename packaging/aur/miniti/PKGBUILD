# Maintainer: Ian Ahuja <hello@miniti.app>
# Miniti Linux built from source. BYOK-only unless MINITI_API_KEY is exported at
# build time (the managed-mode backend key is never in the repo); the -bin
# package built in CI carries it.
pkgname=miniti
pkgver=0.2.0
pkgrel=1
pkgdesc="Miniti — AI meeting assistant with live transcription, insights and coaching"
arch=('x86_64' 'aarch64')
url="https://miniti.app"
license=('custom')
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'librsvg' 'libappindicator-gtk3' 'openssl'
         'pipewire' 'pipewire-pulse' 'libpulse' 'libsecret' 'libnotify' 'hicolor-icon-theme')
makedepends=('rust' 'cargo' 'nodejs' 'pnpm' 'base-devel' 'alsa-lib' 'pkgconf')
optdepends=('gnome-keyring: store the device id in the secret service')
provides=('miniti')
conflicts=('miniti-bin' 'miniti-git')
source=("miniti-${pkgver}.tar.gz::https://github.com/ian/miniti-linux/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "miniti-linux-${pkgver}"
  export CI=true
  pnpm install --frozen-lockfile
  cargo fetch --locked --manifest-path src-tauri/Cargo.toml
}

build() {
  cd "miniti-linux-${pkgver}"
  export CARGO_NET_OFFLINE=true
  # No Tauri updater / signing: pacman owns updates.
  pnpm build
  cargo build --release --frozen --manifest-path src-tauri/Cargo.toml
}

package() {
  cd "miniti-linux-${pkgver}"
  install -Dm755 src-tauri/target/release/miniti "${pkgdir}/usr/bin/miniti"
  install -Dm644 packaging/miniti.desktop "${pkgdir}/usr/share/applications/miniti.desktop"
  install -Dm644 src-tauri/icons/32x32.png "${pkgdir}/usr/share/icons/hicolor/32x32/apps/miniti.png"
  install -Dm644 src-tauri/icons/128x128.png "${pkgdir}/usr/share/icons/hicolor/128x128/apps/miniti.png"
  install -Dm644 src-tauri/icons/128x128@2x.png "${pkgdir}/usr/share/icons/hicolor/256x256@2/apps/miniti.png"
  install -Dm644 src-tauri/icons/icon.png "${pkgdir}/usr/share/icons/hicolor/512x512/apps/miniti.png"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
