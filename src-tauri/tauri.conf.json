{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Miniti",
  "mainBinaryName": "miniti",
  "version": "0.1.0",
  "identifier": "com.miniti.linux",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Miniti — multi-dimensional meetings",
        "width": 960,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480,
        "backgroundColor": "#0A0A0B"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
