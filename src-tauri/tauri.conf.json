{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "miniti",
  "mainBinaryName": "miniti",
  "version": "0.5.0",
  "identifier": "com.miniti.linux",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "miniti",
        "width": 1000,
        "height": 650,
        "minWidth": 760,
        "minHeight": 520,
        "backgroundColor": "#0A0A0B",
        "label": "main",
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 ws://localhost:1421; style-src 'self' 'unsafe-inline' http://localhost:1420; img-src 'self' data: http://localhost:1420; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 ws://localhost:1421; script-src 'self' http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "../packaging/miniti.desktop",
        "files": {
          "/usr/share/metainfo/com.miniti.linux.metainfo.xml": "../packaging/com.miniti.linux.metainfo.xml",
          "/usr/share/man/man1/miniti.1": "../packaging/miniti.1",
          "/usr/share/icons/hicolor/scalable/apps/miniti.svg": "../packaging/icons/miniti.svg",
          "/usr/share/icons/hicolor/symbolic/apps/miniti-symbolic.svg": "../packaging/icons/miniti-symbolic.svg",
          "/usr/share/bash-completion/completions/miniti": "../packaging/completions/miniti.bash",
          "/usr/share/zsh/site-functions/_miniti": "../packaging/completions/_miniti",
          "/usr/share/fish/vendor_completions.d/miniti.fish": "../packaging/completions/miniti.fish"
        },
        "depends": [
          "pipewire",
          "libsecret-1-0",
          "libnotify4"
        ],
        "recommends": [
          "gnome-keyring",
          "xdg-utils",
          "libgtk-layer-shell0"
        ],
        "section": "sound"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "miniti-google",
          "miniti-attio",
          "miniti-twenty"
        ]
      }
    }
  }
}
